{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
"functions": {
  "app/api/analyze/route.ts": {
    "maxDuration": 60
  },
  "app/api/feedback/route.ts": {
    "maxDuration": 60
  },
  "app/api/sms-webhook/route.ts": {
    "maxDuration": 60
  },
  "app/api/whatsapp-webhook/route.ts": {
    "maxDuration": 60
  }
}
}